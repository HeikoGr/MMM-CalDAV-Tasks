{
  "name": "mmm-caldav-tasks",
  "type": "commonjs",
  "version": "2.1.1",
  "description": "MagicMirror module to display and manage CalDAV tasks (to-dos)",
  "keywords": [
    "magicmirror",
    "magicmirror2",
    "magicmirror-module",
    "caldav",
    "tasks",
    "todo",
    "nextcloud"
  ],
  "main": "MMM-CalDAV-Tasks.js",
  "author": "HeikoGr",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-CalDAV-Tasks.git"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-mmm-shared-submodule.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "node --run mmcheck",
    "debug": "node scripts/cli-debug.js",
    "debug:help": "node scripts/cli-debug.js help",
    "debug:config": "node scripts/cli-debug.js test-config",
    "debug:fetch": "node scripts/cli-debug.js fetch",
    "mmcheck": "node scripts/magicmirror-check.mjs --devcontainer-only --current",
    "deps:update": "npx --yes npm-check-updates -u && npm install && npx @biomejs/biome migrate --write",
    "shared:update": "git submodule update --remote --init --checkout lib/mmm-shared && git submodule status lib/mmm-shared"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lint-staged": "^17.3.0",
    "prettier-plugin-jinja-template": "^2.2.0",
    "simple-git-hooks": "^2.14.0"
  },
  "dependencies": {
    "moment": "^2.30.1",
    "node-ical": "^0.27.1",
    "rrule": "^2.8.1",
    "tsdav": "^2.3.1",
    "webdav": "^5.10.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1 && node scripts/check-commit-scope.js $1"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  }
}