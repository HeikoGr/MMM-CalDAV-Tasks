{
  "name": "mmm-caldav-tasks",
  "version": "2.4.0",
  "private": true,
  "description": "MagicMirror module to display and manage CalDAV tasks (to-dos)",
  "keywords": [
    "magicmirror",
    "magicmirror2",
    "magicmirror-module",
    "caldav",
    "tasks",
    "todo",
    "nextcloud"
  ],
  "homepage": "https://github.com/HeikoGr/MMM-CalDAV-Tasks#readme",
  "bugs": {
    "url": "https://github.com/HeikoGr/MMM-CalDAV-Tasks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-CalDAV-Tasks.git"
  },
  "license": "MIT",
  "author": "HeikoGr",
  "type": "commonjs",
  "main": "MMM-CalDAV-Tasks.js",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-mmm-shared-submodule.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/magicmirror-check.mjs --current",
    "shared:update": "git submodule update --remote --init --checkout lib/mmm-shared && git submodule status lib/mmm-shared",
    "deps:update": "npx --yes npm-check-updates -u && npm install && biome migrate --write",
    "debug": "node scripts/cli-debug.js",
    "debug:help": "node scripts/cli-debug.js help",
    "debug:config": "node scripts/cli-debug.js test-config",
    "debug:fetch": "node scripts/cli-debug.js fetch"
  },
  "dependencies": {
    "moment": "^2.31.0",
    "node-ical": "^0.27.2",
    "rrule": "^2.8.1",
    "tsdav": "^2.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lint-staged": "^17.5.1",
    "simple-git-hooks": "^2.14.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1 && node scripts/check-commit-scope.js $1"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  }
}
